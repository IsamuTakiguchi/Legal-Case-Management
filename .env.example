# ===== 基本 =====
PORT=8787
PUBLIC_BASE_URL=https://your-public-host.example.com
DATA_DIR=./data
# ログイン用パスワード（初回起動時に bcrypt ハッシュ化して保存）
APP_PASSWORD=change-me
# セッション署名用の長いランダム文字列
SESSION_SECRET=change-me-to-a-long-random-string
TZ=Asia/Tokyo

# ===== Anthropic =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ===== LINE 公式アカウント (Messaging API) =====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# プランの月間プッシュ上限（ライト=5000, スタンダード=30000）
LINE_MONTHLY_PUSH_LIMIT=5000

# ===== Chatwork =====
CHATWORK_API_TOKEN=
CHATWORK_WEBHOOK_TOKEN=
# 通知先ルーム（空ならマイチャットを自動検出）
CHATWORK_NOTIFY_ROOM_ID=

# ===== Google (Gmail + Calendar) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# リダイレクト URI は {PUBLIC_BASE_URL}/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# ===== Zoom (Server-to-Server OAuth) =====
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ===== Microsoft (OneDrive for Business) =====
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# リダイレクト URI は {PUBLIC_BASE_URL}/api/auth/microsoft/callback

# ===== ストレージ =====
# onedrive | local
STORAGE_BACKEND=onedrive
# OneDrive 上の依頼者フォルダのルート（先頭にスラッシュ）
ONEDRIVE_CLIENT_ROOT=/依頼者
# local の場合の同期フォルダ絶対パス
LOCAL_CLIENT_ROOT=/mnt/onedrive/依頼者

# ===== Cloudflare Tunnel（事務所 PC で公開 URL を作る場合） =====
CLOUDFLARE_TUNNEL_TOKEN=
